# GridGuard Frontend Environment Variables
# Copy this file to .env and fill in your actual credentials
# Never commit .env to version control

# ========================================
# SUPABASE CONFIGURATION
# ========================================

# Supabase Project URL
# Get from: Supabase Dashboard > Project Settings > API > Project URL
# Used for authentication and real-time data
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon Key (for frontend-facing API access)
# Get from: Supabase Dashboard > Project Settings > API > Anon/Public Key
# This key is safe to expose in frontend code (read-only, user-level access)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
