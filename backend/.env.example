# GridGuard Backend Environment Variables
# Copy this file to .env and fill in your actual credentials
# Never commit .env to version control

# ========================================
# SUPABASE CONFIGURATION
# ========================================

# Supabase Project URL
# Get from: Supabase Dashboard > Project Settings > API > Project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase Service Role Key (for backend API access)
# Get from: Supabase Dashboard > Project Settings > API > Service Role Key
# WARNING: Keep this secret! This key has full database access.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase JWT Secret (for verifying auth tokens locally during development)
# Get from: Supabase Dashboard > Project Settings > API > JWT Settings
# Only needed for local development; in production, tokens are verified using public key
SUPABASE_JWT_SECRET=your-super-secret-jwt-secret-here

# PostgreSQL Connection String (direct database access for SQLAlchemy)
# Get from: Supabase Dashboard > Project Settings > Database > Connection string
# Use the "URI" connection string format (not psql format)
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ========================================
# CLAUDE API CONFIGURATION
# ========================================

# Claude API Key (for AI operator summaries)
# Get from: https://console.anthropic.com > API Keys
# Used by ai_reporter.py to generate plain-English summaries for critical alerts
# If empty, the backend will use a fallback summary (no API calls)
CLAUDE_API_KEY=sk-ant-v7-...
